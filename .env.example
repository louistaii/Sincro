# Copy this file to .env in the repository root and fill in your server-side key.
# python -m sincro.web loads it at startup. Existing process variables win.
# .env is gitignored. Never put API keys in web.html or browser storage.
GEMINI_API_KEY=

# Optional: override the Gemini model used by the /ask assistant.
# Defaults to gemini-2.5-flash (set in src/sincro/gemini_client.py).
# GEMINI_MODEL=gemini-2.5-flash
